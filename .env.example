# LLM (по умолчанию OpenRouter). Ключ обязателен, остальное можно не менять.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Qdrant для скриптов и ноутбука на хосте.
# В docker compose приложение получает http://qdrant:6333 из docker-compose.yml.
QDRANT_URL=http://localhost:6333

APP_NAME=API Task
LOG_LEVEL=INFO
DEBUG=false
